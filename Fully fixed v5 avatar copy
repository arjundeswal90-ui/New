local function getTargetPlayer(nameText)
	nameText = nameText:lower():gsub("%s+", "")
	for _, p in pairs(Players:GetPlayers()) do
		if p.Name:lower():sub(1, #nameText) == nameText or p.DisplayName:lower():sub(1, #nameText) == nameText then
			return p
		end
	end
	return nil
end

local function applyCleanOutfit(userId)
	local myChar = LocalPlayer.Character
	if not myChar or not myChar:FindFirstChild("Humanoid") then return end

	local myHum = myChar.Humanoid

	-- Fetch target description directly from Roblox API
	local success, targetDesc = pcall(function()
		return Players:GetHumanoidDescriptionFromUserId(userId)
	end)

	if success and targetDesc then
		-- Safe accessories cleanup (prevents grounding/physics glitch)
		for _, v in pairs(myChar:GetChildren()) do
			if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("BodyColors") or v:IsA("CharacterMesh") then
				v:Destroy()
			end
		end

		task.wait(0.1)

		-- Apply full humanoid description safely
		pcall(function()
			myHum:ApplyDescriptionClientServer(targetDesc)
		end)
		
		pcall(function()
			myHum:ApplyDescription(targetDesc)
		end)
	else
		TextBox.Text = "Failed to Fetch API!"
	end
end

CopyBtn.MouseButton1Click:Connect(function()
	local target = getTargetPlayer(TextBox.Text)
	if target then
		TextBox.Text = target.Name
		applyCleanOutfit(target.UserId)
	else
		TextBox.Text = "Player Not Found!"
	end
end)

ResetBtn.MouseButton1Click:Connect(function()
	applyCleanOutfit(LocalPlayer.UserId)
end)
